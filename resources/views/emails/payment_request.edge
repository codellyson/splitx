<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>
      Payment Request - {{ groupName }}
    </title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f9f9f9;
        color: #222;
      }

      .container {
        background: #fff;
        padding: 2rem;
        border-radius: 8px;
        max-width: 480px;
        margin: 2rem auto;
        box-shadow: 0 2px 8px #eee;
      }

      .btn {
        display: inline-block;
        background: #14b8a6;
        color: #fff;
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 1.5rem;
      }

      .footer {
        margin-top: 2rem;
        font-size: 0.9em;
        color: #888;
      }

      .amount {
        font-size: 2rem;
        font-weight: bold;
        color: #14b8a6;
        text-align: center;
        margin: 1rem 0;
      }

      .group-info {
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        padding: 1rem;
        border-radius: 4px;
        margin: 1rem 0;
      }

      .message {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        padding: 1rem;
        border-radius: 4px;
        margin: 1rem 0;
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>
        Payment Request
      </h2>
      <p>
        Hello {{ recipientName }},
      </p>

      <div class="group-info">
        <h3 style="margin: 0 0 0.5rem 0; color: #374151;">
          {{ groupName }}
        </h3>
        <p style="margin: 0; color: #6b7280;">
          You have an outstanding balance that needs to be settled.
        </p>
      </div>

      <div class="amount">
        {{ amount }}
      </div>

      @if(message)
        <div class="message">
          <strong>Message:</strong>          <br />
          "{{ message }}"
        </div>
      @endif

      <p>
        Please click the button below to settle your payment securely:
      </p>

      <a href="{{ paymentLink }}" class="btn">Pay Now</a>

      <p style="margin-top: 1.5rem; font-size: 0.9em; color: #6b7280;">
        If you have any questions about this payment request, please contact the group administrator.
      </p>

      <div class="footer">
        &copy; {{ new Date().getFullYear() }} SplitX. All rights reserved.
      </div>
    </div>
  </body>
</html>
