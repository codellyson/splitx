<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>
      Your SplitX Account Details
    </title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f9f9f9;
        color: #222;
      }

      .container {
        background: #fff;
        padding: 2rem;
        border-radius: 8px;
        max-width: 480px;
        margin: 2rem auto;
        box-shadow: 0 2px 8px #eee;
      }

      .btn {
        display: inline-block;
        background: #14b8a6;
        color: #fff;
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 1.5rem;
      }

      .footer {
        margin-top: 2rem;
        font-size: 0.9em;
        color: #888;
      }

      .credentials {
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        padding: 1rem;
        border-radius: 4px;
        margin: 1rem 0;
      }

      .warning {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        padding: 1rem;
        border-radius: 4px;
        margin: 1rem 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>
        Welcome to SplitX!
      </h2>
      <p>
        Hello {{ user.full_name || 'there' }},
      </p>
      <p>
        An account has been created for you on SplitX. Here are your login credentials:
      </p>

      <div class="credentials">
        <p>
          <strong>Email:</strong>{{ user.email }}
        </p>
        <p>
          <strong>Temporary Password:</strong>{{ password }}
        </p>
      </div>

      <div class="warning">
        <strong>Security Notice:</strong>Please change your password after your first login.
      </div>

      <a href="{{ APP_URL }}/auth" class="btn">Login to SplitX</a>

      <p style="margin-top: 1.5rem;">
        You can now log in and start managing your expenses with your group!
      </p>

      <div class="footer">
        &copy; {{ new Date().getFullYear() }} SplitX. All rights reserved.
      </div>
    </div>
  </body>
</html>
